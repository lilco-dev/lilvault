# Local runs can use an agent key directory; no environment variable is required.
# mkdir -p keys && openssl rand -hex 32 > keys/my-agent.token
# printf 'test:read-write\n' > keys/my-agent.permissions
# Then set [auth] keys_dir in config.toml. If you prefer explicit [[agents]]
# entries with token_env, those still work; the server never loads .env files.
