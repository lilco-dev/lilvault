# Local runs use an agent key directory; no environment variable is required.
# Generate keys with: mkdir -p keys && openssl rand -hex 32 > keys/hermes.token
# Then set [auth] keys_dir in config.toml. Read-only agents use <name>.ro.token.
# If you prefer [[agents]] entries with token_env, those still work: the server
# reads process environment variables and never loads .env files.
