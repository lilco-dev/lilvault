# Official client; build locally for self-hosted use, do not publish credentialed images.
FROM node:26.13.0-bookworm-slim

RUN npm install --global --omit=dev obsidian-headless@0.0.14 \
    && npm cache clean --force

ENV HOME=/home/node
USER node
WORKDIR /home/node
ENTRYPOINT ["ob"]
CMD ["--help"]
