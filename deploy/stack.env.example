# Set these privately in Portainer's stack environment; this is not a token file.
LILVAULT_ROOT=/mnt/<pool>/apps/lilvault
LILVAULT_UID=1000
LILVAULT_GID=1000
# Required: use your existing agent token to preserve client access.
LILVAULT_HERMES_TOKEN=
# Required only if enabled in config/gateway.toml.
LILVAULT_SECOND_AGENT_TOKEN=
