# Set privately in Portainer. Never commit actual credentials.
LILVAULT_ROOT=/mnt/<pool>/apps/lilvault
# TrueNAS built-in apps UID/GID; override on other platforms.
LILVAULT_UID=568
LILVAULT_GID=568
# latest tracks tested main builds; use a release/sha tag for controlled updates.
LILVAULT_IMAGE_TAG=latest
# Optional approved private HTTPS authority, without scheme or path.
LILVAULT_MCP_HOST=
# Required; reuse the existing value when migrating.
LILVAULT_HERMES_TOKEN=
# Optional; its presence enables a second agents:read-write credential.
LILVAULT_SECOND_AGENT_TOKEN=
